# Provider selection (defaults to openai when omitted)
AI_PROVIDER=openai

# Provider-specific values take precedence over generic AI_* fallbacks
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional generic fallbacks, useful for registered custom providers
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=

# Optional positive embedding vector size; blank uses the provider default
AI_EMBEDDING_DIMENSIONS=

# Structured-response retries after the initial request
AI_MAX_RETRIES=1

# Optional custom USD prices; configure both values to override built-in rates
AI_INPUT_COST_PER_1M_TOKENS=
AI_OUTPUT_COST_PER_1M_TOKENS=

# Toolkit-managed logging
AI_LOG_LEVEL=INFO
AI_LOG_FILE_PATH=logs/ai_toolkit.log
AI_FILE_LOGGING_ENABLED=true
